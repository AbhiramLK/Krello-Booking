# PostgreSQL connection. `pnpm db:start` runs an embedded server on this port.
DATABASE_URL=postgres://krello:krello@localhost:54329/krello
# Secret used to sign session cookies. Change in any shared environment.
SESSION_SECRET=dev-only-change-me-dev-only-change-me
# Phone number (E.164) that is treated as platform super-admin.
SUPER_ADMIN_PHONE=+919000000001
